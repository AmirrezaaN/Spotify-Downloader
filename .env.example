# Copy this file to .env and fill in the values.

# ---- Telegram bot ----
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Shown as a "Telegram bot" link on the website (without @)
TELEGRAM_BOT_USERNAME=
# Optional: a local Bot API server (raises the upload limit from 50 MB to 2000 MB)
TELEGRAM_API_URL=

# ---- Network ----
# Optional proxy for Telegram, Spotify, YouTube and LRCLIB, e.g. socks5://127.0.0.1:10808 or http://127.0.0.1:10809
PROXY_URL=

# ---- Downloads ----
APP_NAME=SpotiLoad
MAX_CONCURRENT_DOWNLOADS=3
PLAYLIST_LIMIT=100
LYRICS_ENABLED=true
# synced = time-stamped LRC (shown in sync by most Android players), plain = text only
LYRICS_STYLE=synced
# Delete local files not used for this many days (0 = keep forever). The bot re-sends old tracks by file_id anyway.
KEEP_FILES_DAYS=7
# Optional: cookies.txt from a YouTube Premium account gives real AAC 256 kbps instead of Opus ~130 kbps
YT_COOKIES_FILE=
# Optional: full path to ffmpeg if it is not on PATH
FFMPEG_PATH=

# ---- Website (Django) ----
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
